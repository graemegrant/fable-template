# Sanity — leave blank to run entirely on static fallback data
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Canonical site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.craigmorehouse.com

# Booking engine deep link (FreeToBook / Guestline / SiteMinder / Little Hotelier)
# Leave blank to route booking CTAs to /contact
NEXT_PUBLIC_BOOKING_ENGINE_URL=

# Contact form (Resend) — graceful no-op when key is unset
RESEND_API_KEY=
CONTACT_FORM_TO=enquiries@craigmorehouse.com
CONTACT_FORM_FROM=website@craigmorehouse.com

# Analytics (optional)
NEXT_PUBLIC_GA4_ID=
